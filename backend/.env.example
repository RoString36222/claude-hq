# Copy to .env. The Arena (backend-rs) reads these from its environment;
# selfhost-wizard.sh writes this file for you on a Mac.

# SQLite file. Use an absolute path in production (four slashes:
# sqlite+aiosqlite:////abs/path/arena.db, or sqlite:/abs/path/arena.db):
# a relative one is resolved against wherever the service was started.
# docker-compose.yml overrides this with a file on the arena-data volume.
ARENA_DATABASE_URL=sqlite+aiosqlite:///./arena.db

# Signs pairing codes and websocket tickets. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ARENA_SECRET_KEY=dev-only-insecure-change-me

# GitHub OAuth app (Settings -> Developer settings -> OAuth Apps).
# Authorization callback URL must be exactly:
#   <ARENA_PUBLIC_BASE_URL>/v1/auth/github/callback
ARENA_GITHUB_CLIENT_ID=
ARENA_GITHUB_CLIENT_SECRET=
ARENA_PUBLIC_BASE_URL=http://127.0.0.1:8080
