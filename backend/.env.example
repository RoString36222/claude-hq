# Copy to .env for local development. In production these are Fly secrets.

# Neon connection string, with the async driver:
#   postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require
# Neon's dashboard gives you postgresql://... -- the scheme MUST be changed to
# postgresql+asyncpg:// or SQLAlchemy loads the sync driver and the app will not
# start. deploy-wizard.sh does this conversion for you.
ARENA_DATABASE_URL=sqlite+aiosqlite:///./arena.db

# Signs pairing codes and websocket tickets. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The server refuses to start with this placeholder or any key shorter than
# 32 characters, unless ARENA_DEV=1.
ARENA_SECRET_KEY=dev-only-insecure-change-me

# Local development only: allows the placeholder/short secret key above.
# Never set this on a server other people use.
# ARENA_DEV=1

# Device tokens unused for this many days are revoked on next use.
# ARENA_DEVICE_IDLE_DAYS=90

# Per-day ingest clamps; a day above any of them is rejected.
# ARENA_MAX_DAILY_PROMPTS=5000
# ARENA_MAX_DAILY_TOOLS=50000
# ARENA_MAX_DAILY_ARTIFACTS=5000
# ARENA_MAX_DAILY_REPLIES=50000
# ARENA_MAX_DAILY_TOKENS=10000000000

# GitHub OAuth app (Settings -> Developer settings -> OAuth Apps).
# Authorization callback URL must be exactly:
#   <ARENA_PUBLIC_BASE_URL>/v1/auth/github/callback
ARENA_GITHUB_CLIENT_ID=
ARENA_GITHUB_CLIENT_SECRET=
ARENA_PUBLIC_BASE_URL=http://127.0.0.1:8080
